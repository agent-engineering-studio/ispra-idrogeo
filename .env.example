# Copy to .env to change the defaults of `make up` / `make notebooks`.
# Nothing here is needed to use the library itself.

# The prefix of every container, image, volume and network. Change it to run
# a second copy next to the first one (and change the ports too).
IDROGEO_NAME=ispra-idrogeo

# The MCP server, on this computer only: http://localhost:8767/mcp
IDROGEO_MCP_PORT=8767

# Jupyter, on this computer only: http://localhost:8888/lab?token=idrogeo
IDROGEO_JUPYTER_PORT=8888
IDROGEO_JUPYTER_TOKEN=idrogeo

# La Mappa dei dati (make app-up): http://localhost:3002/?comune=<ISTAT>
IDROGEO_APP_PORT=3002
# The body's name in the header, and the municipality the map opens on (ISTAT code).
IDROGEO_ENTE=Mappa dei dati su frane e pericolo
IDROGEO_COMUNE=65135
# Map tiles: OpenStreetMap by default (it sees the visitors' IP). Set your own if you prefer.
IDROGEO_TILES=
IDROGEO_TILES_CREDIT=

# --- AI (optional) ---------------------------------------------------------
# The key of the Claude API (https://console.anthropic.com/). Only
# `make eval` reads it (the agent eval in evals/, paid API calls). The library,
# the MCP server and the containers never use it. Without it, nothing calls a
# model. Keep it in .env, which git ignores: never in this file.
ANTHROPIC_API_KEY=
